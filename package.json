{
  "name": "models-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "catalog:audit": "node scripts/audit.ts",
    "catalog:audit:refresh": "node scripts/audit.ts --write && oxfmt catalog/schema-inventory.json",
    "catalog:check": "pnpm build && node scripts/catalog.ts && node scripts/overlays.ts && node scripts/audit.ts",
    "catalog:refresh": "pnpm build && node scripts/catalog.ts --write && node scripts/overlays.ts --write && node scripts/audit.ts --write && oxfmt catalog/schema-inventory.json",
    "check": "pnpm format:check && pnpm icons:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:packages && pnpm check:site",
    "check:packages": "publint packages/models --strict && node scripts/checkPackages.ts",
    "dev": "pnpm --filter @models/gallery dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "icons:check": "node scripts/icons.ts",
    "icons:refresh": "node scripts/icons.ts --write",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "check:site": "node scripts/checkSite.ts",
    "prepare:packages": "node scripts/packageArtifacts.ts",
    "check:starters": "node scripts/checkStarters.ts"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai": "^4.0.96",
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@lobehub/icons-static-svg": "1.95.1",
    "@types/node": "^26.6.5",
    "ai": "^7.0.143",
    "happy-dom": "^20.12.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1"
}
