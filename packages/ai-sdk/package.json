{
  "name": "@models/ai-sdk",
  "version": "0.1.0",
  "description": "A small bridge from Models selections to AI SDK calls.",
  "keywords": [
    "ai",
    "ai-sdk",
    "models",
    "vercel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axel-rock/models.git",
    "directory": "packages/ai-sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@models/core": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=7 <8"
  },
  "engines": {
    "node": ">=22"
  }
}
